{
  "name": "@digitalspace/eagle-analytics-client",
  "version": "0.1.0",
  "description": "Browser client for the EPIC analytics ingest API. No runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalspace/eagle-analytics.git",
    "directory": "client"
  },
  "engines": {
    "node": ">=20"
  }
}
