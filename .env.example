# Copy to .env.local and restart `yarn start`. Values below are the test defaults.
# Change the Keycloak and API lines together. Hosts per environment: wiki Frontend-Environment-Targets page.
KEYCLOAK_URL=https://test.loginproxy.gov.bc.ca/auth
KEYCLOAK_REALM=eao-epic
EAGLE_API_TARGET=https://eagle-test.apps.silver.devops.gov.bc.ca
DEMI_API_TARGET=https://demi-apim-test.azure-api.net

